{
  "$defs": {
    "AlcoholContent": {
      "additionalProperties": false,
      "properties": {
        "abvPercent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Abvpercent",
          "type": "number"
        },
        "expectedDisplayText": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expecteddisplaytext"
        },
        "proof": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof"
        }
      },
      "required": [
        "abvPercent"
      ],
      "title": "AlcoholContent",
      "type": "object"
    },
    "ApplicationRecord": {
      "additionalProperties": false,
      "properties": {
        "beverageType": {
          "$ref": "#/$defs/BeverageType"
        },
        "expectedLabel": {
          "$ref": "#/$defs/ExpectedLabelFields"
        },
        "imported": {
          "title": "Imported",
          "type": "boolean"
        },
        "intakeSource": {
          "$ref": "#/$defs/IntakeSource"
        },
        "recordId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Recordid",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "recordId",
        "intakeSource",
        "beverageType",
        "imported",
        "expectedLabel"
      ],
      "title": "ApplicationRecord",
      "type": "object"
    },
    "BeverageType": {
      "enum": [
        "beer",
        "wine",
        "distilled_spirits"
      ],
      "title": "BeverageType",
      "type": "string"
    },
    "BoundingPolygon": {
      "additionalProperties": false,
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 8,
          "minItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "BoundingPolygon",
      "type": "object"
    },
    "ComparisonInput": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "$ref": "#/$defs/ApplicationRecord"
        },
        "comparisonId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Comparisonid",
          "type": "string"
        },
        "extraction": {
          "$ref": "#/$defs/OcrExtractionResult"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/LabelImageInput"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Images",
          "type": "array"
        },
        "ruleset": {
          "$ref": "#/$defs/RulesetReference"
        }
      },
      "required": [
        "comparisonId",
        "application",
        "images",
        "extraction",
        "ruleset"
      ],
      "title": "ComparisonInput",
      "type": "object"
    },
    "ComparisonRequest": {
      "additionalProperties": false,
      "description": "Public comparison request; the API selects the approved ruleset server-side.",
      "properties": {
        "comparisonId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Comparisonid",
          "type": "string"
        },
        "extraction": {
          "$ref": "#/$defs/OcrExtractionResult"
        },
        "submission": {
          "$ref": "#/$defs/VerificationSubmission"
        }
      },
      "required": [
        "comparisonId",
        "submission",
        "extraction"
      ],
      "title": "ComparisonRequest",
      "type": "object"
    },
    "ComparisonValue": {
      "additionalProperties": false,
      "properties": {
        "displayValue": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Displayvalue",
          "type": "string"
        },
        "normalizedValue": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalizedvalue"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "displayValue"
      ],
      "title": "ComparisonValue",
      "type": "object"
    },
    "CountryOfOrigin": {
      "additionalProperties": false,
      "properties": {
        "countryCode": {
          "pattern": "^[A-Z]{2}$",
          "title": "Countrycode",
          "type": "string"
        },
        "displayName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        }
      },
      "required": [
        "countryCode",
        "displayName"
      ],
      "title": "CountryOfOrigin",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "imageId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Imageid",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingPolygon"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "segmentIds": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Segmentids",
          "type": "array"
        }
      },
      "required": [
        "imageId"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExpectedLabelFields": {
      "additionalProperties": false,
      "properties": {
        "additionalRequiredStatements": {
          "items": {
            "$ref": "#/$defs/ExpectedStatement"
          },
          "title": "Additionalrequiredstatements",
          "type": "array"
        },
        "alcoholContent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlcoholContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "appellationOfOrigin": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appellationoforigin"
        },
        "brandName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Brandname",
          "type": "string"
        },
        "classTypeDesignation": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Classtypedesignation",
          "type": "string"
        },
        "countryOfOrigin": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountryOfOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "netContents": {
          "$ref": "#/$defs/NetContents"
        },
        "responsibleParties": {
          "items": {
            "$ref": "#/$defs/ResponsibleParty"
          },
          "minItems": 1,
          "title": "Responsibleparties",
          "type": "array"
        }
      },
      "required": [
        "brandName",
        "classTypeDesignation",
        "netContents",
        "responsibleParties"
      ],
      "title": "ExpectedLabelFields",
      "type": "object"
    },
    "ExpectedStatement": {
      "additionalProperties": false,
      "properties": {
        "expectedText": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Expectedtext",
          "type": "string"
        },
        "ruleReference": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rulereference"
        },
        "statementType": {
          "$ref": "#/$defs/StatementType"
        }
      },
      "required": [
        "statementType",
        "expectedText"
      ],
      "title": "ExpectedStatement",
      "type": "object"
    },
    "ExtractedFieldCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidenceSegmentIds": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidencesegmentids",
          "type": "array"
        },
        "field": {
          "$ref": "#/$defs/VerificationField"
        },
        "normalizedValue": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalizedvalue"
        },
        "rawText": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Rawtext",
          "type": "string"
        }
      },
      "required": [
        "field",
        "rawText",
        "evidenceSegmentIds"
      ],
      "title": "ExtractedFieldCandidate",
      "type": "object"
    },
    "ExtractionIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ExtractionIssueCode"
        },
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationField"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "imageId": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imageid"
        },
        "message": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ExtractionIssue",
      "type": "object"
    },
    "ExtractionIssueCode": {
      "enum": [
        "low_confidence",
        "no_text_found",
        "image_unreadable",
        "unsupported_layout",
        "extractor_timeout",
        "extractor_unavailable",
        "not_label_image",
        "label_classification_uncertain",
        "warning_text_incomplete",
        "extractor_refused",
        "extractor_invalid_response"
      ],
      "title": "ExtractionIssueCode",
      "type": "string"
    },
    "ExtractionStatus": {
      "enum": [
        "succeeded",
        "partial",
        "failed"
      ],
      "title": "ExtractionStatus",
      "type": "string"
    },
    "ExtractionTiming": {
      "additionalProperties": false,
      "properties": {
        "imagePreparationMs": {
          "minimum": 0,
          "title": "Imagepreparationms",
          "type": "integer"
        },
        "providerMs": {
          "minimum": 0,
          "title": "Providerms",
          "type": "integer"
        }
      },
      "required": [
        "imagePreparationMs",
        "providerMs"
      ],
      "title": "ExtractionTiming",
      "type": "object"
    },
    "ExtractorReference": {
      "additionalProperties": false,
      "properties": {
        "modelVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ExtractorReference",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "information",
        "review",
        "discrepancy"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "HumanReviewDecision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "HumanReviewDecision",
      "type": "string"
    },
    "HumanReviewDecisionRequest": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decision": {
          "$ref": "#/$defs/HumanReviewDecision"
        }
      },
      "required": [
        "decision"
      ],
      "title": "HumanReviewDecisionRequest",
      "type": "object"
    },
    "HumanReviewReceipt": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decidedAt": {
          "format": "date-time",
          "title": "Decidedat",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/HumanReviewDecision"
        },
        "decisionId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decisionid",
          "type": "string"
        },
        "queueItemId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Queueitemid",
          "type": "string"
        },
        "remainingCount": {
          "minimum": 0,
          "title": "Remainingcount",
          "type": "integer"
        },
        "undoExpiresAt": {
          "format": "date-time",
          "title": "Undoexpiresat",
          "type": "string"
        }
      },
      "required": [
        "decisionId",
        "queueItemId",
        "decision",
        "decidedAt",
        "undoExpiresAt",
        "remainingCount"
      ],
      "title": "HumanReviewReceipt",
      "type": "object"
    },
    "ImageMediaType": {
      "enum": [
        "image/jpeg",
        "image/png"
      ],
      "title": "ImageMediaType",
      "type": "string"
    },
    "IntakeSource": {
      "enum": [
        "preloaded",
        "ad_hoc",
        "batch"
      ],
      "title": "IntakeSource",
      "type": "string"
    },
    "LabelImageInput": {
      "additionalProperties": false,
      "properties": {
        "clientImageId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Clientimageid",
          "type": "string"
        },
        "fileName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mediaType": {
          "$ref": "#/$defs/ImageMediaType"
        },
        "panelType": {
          "$ref": "#/$defs/LabelPanelType",
          "default": "unknown"
        },
        "sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "sizeBytes": {
          "exclusiveMinimum": 0,
          "maximum": 20000000,
          "title": "Sizebytes",
          "type": "integer"
        }
      },
      "required": [
        "clientImageId",
        "fileName",
        "mediaType",
        "sizeBytes"
      ],
      "title": "LabelImageInput",
      "type": "object"
    },
    "LabelPanelType": {
      "enum": [
        "brand",
        "back",
        "side",
        "neck",
        "other",
        "unknown"
      ],
      "title": "LabelPanelType",
      "type": "string"
    },
    "NetContents": {
      "additionalProperties": false,
      "properties": {
        "expectedDisplayText": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expecteddisplaytext"
        },
        "unit": {
          "$ref": "#/$defs/NetContentsUnit"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "NetContents",
      "type": "object"
    },
    "NetContentsUnit": {
      "enum": [
        "mL",
        "L",
        "fl_oz",
        "pt",
        "qt",
        "gal"
      ],
      "title": "NetContentsUnit",
      "type": "string"
    },
    "OcrExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "minimum": 0,
          "title": "Durationms",
          "type": "integer"
        },
        "extractionId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Extractionid",
          "type": "string"
        },
        "extractor": {
          "$ref": "#/$defs/ExtractorReference"
        },
        "fieldCandidates": {
          "items": {
            "$ref": "#/$defs/ExtractedFieldCandidate"
          },
          "title": "Fieldcandidates",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ExtractionIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TextSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExtractionStatus"
        },
        "submissionId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Submissionid",
          "type": "string"
        },
        "timing": {
          "$ref": "#/$defs/ExtractionTiming"
        }
      },
      "required": [
        "extractionId",
        "submissionId",
        "status",
        "extractor",
        "durationMs",
        "timing"
      ],
      "title": "OcrExtractionResult",
      "type": "object"
    },
    "OverallReviewStatus": {
      "enum": [
        "no_discrepancies_found",
        "review_needed",
        "analysis_incomplete"
      ],
      "title": "OverallReviewStatus",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "PostalAddress": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "maxLength": 255,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "countryCode": {
          "pattern": "^[A-Z]{2}$",
          "title": "Countrycode",
          "type": "string"
        },
        "postalCode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postalcode"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "streetLines": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Streetlines",
          "type": "array"
        }
      },
      "required": [
        "city",
        "countryCode"
      ],
      "title": "PostalAddress",
      "type": "object"
    },
    "ResponsibleParty": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/PostalAddress"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "statementPrefix": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statementprefix"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "title": "ResponsibleParty",
      "type": "object"
    },
    "ReviewQueueImage": {
      "additionalProperties": false,
      "properties": {
        "altText": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Alttext",
          "type": "string"
        },
        "imageId": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Imageid",
          "type": "string"
        },
        "imageUrl": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Imageurl",
          "type": "string"
        },
        "panelType": {
          "$ref": "#/$defs/LabelPanelType"
        }
      },
      "required": [
        "imageId",
